#!/usr/bin/env python3
"""Switch file-based Codex logins after stopping the shared daemon."""

import argparse
import base64
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

VERSION = "1.0.0-dev"


class AccountError(Exception):
    pass


def codex_home():
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser().resolve()


def account_path(home, name):
    if (not name or name in {".", ".."} or name != name.strip()
            or any(c in "/\\" or not c.isprintable() for c in name)):
        raise AccountError("Account names must be printable, without slashes or surrounding spaces.")
    return home / "accounts" / (name + ".json")


def read_auth(path):
    try:
        raw = path.read_bytes()
        auth = json.loads(raw)
    except FileNotFoundError:
        raise AccountError(f"No credentials at {path}. Run 'codex login' or check the account name.") from None
    except (ValueError, UnicodeError):
        # JSON decoder messages can contain credential contents.
        raise AccountError(f"Invalid credential JSON at {path}.") from None
    if not isinstance(auth, dict):
        raise AccountError(f"Expected a credential object at {path}.")
    tokens = auth.get("tokens") or {}
    if not isinstance(tokens, dict):
        raise AccountError(f"Invalid tokens object at {path}.")
    for key in ("id_token", "access_token", "refresh_token", "account_id"):
        if tokens.get(key) is not None and not isinstance(tokens[key], str):
            raise AccountError(f"Invalid token field at {path}.")
    api_key = auth.get("OPENAI_API_KEY")
    if api_key is not None and not isinstance(api_key, str):
        raise AccountError(f"Invalid API key field at {path}.")
    if not api_key and not (tokens.get("id_token") and tokens.get("access_token")):
        raise AccountError(f"No supported Codex credentials at {path}.")
    return raw, auth


def claims(auth):
    """Read display/identity claims locally; this does not verify a JWT."""
    token = (auth.get("tokens") or {}).get("id_token", "")
    try:
        payload = token.split(".")[1]
        decoded = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        return decoded if isinstance(decoded, dict) else {}
    except (IndexError, ValueError, UnicodeError):
        return {}


def identity(auth):
    if auth.get("OPENAI_API_KEY"):
        return ("api-key", auth["OPENAI_API_KEY"])
    payload = claims(auth)
    subject = payload.get("sub") or payload.get("email")
    if subject:
        return ("chatgpt", subject, (auth.get("tokens") or {}).get("account_id"))
    return None


def describe(auth):
    payload = claims(auth)
    info = payload.get("https://api.openai.com/auth") or {}
    plan = info.get("chatgpt_plan_type", "?") if isinstance(info, dict) else "?"
    email = payload.get("email") or ("API key" if auth.get("OPENAI_API_KEY") else "unknown")
    # Credential-controlled text must not insert terminal control sequences.
    return tuple("".join(c for c in str(value) if c.isprintable()) for value in (email, plan))


def saved_accounts(home):
    for path in sorted((home / "accounts").glob("*.json")):
        try:
            _, auth = read_auth(path)
        except AccountError as exc:
            print(f"Warning: {exc}", file=sys.stderr)
            continue
        yield path, auth


def matching_account(home, auth):
    key = identity(auth)
    matches = [path for path, saved in saved_accounts(home)
               if saved == auth or (key is not None and identity(saved) == key)]
    # Multiple labels for the same identity are ambiguous. Do not overwrite one.
    return matches[0] if len(matches) == 1 else None


def write_auth(path, raw):
    """Publish a complete credential file with owner-only permissions."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".codex-accounts-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextmanager
def account_lock(home):
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(home / ".codex-accounts.lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise AccountError("Another codex-accounts command is running. Try again after it finishes.") from None
        yield
    finally:
        os.close(fd)


def check_storage(home):
    """Check an explicitly configured top-level storage setting without a TOML dependency."""
    config = home / "config.toml"
    if not config.exists():
        return
    for line in config.read_text().splitlines():
        if line.lstrip().startswith("["):
            break
        match = re.match(r'''\s*(?:cli_auth_credentials_store|"cli_auth_credentials_store"|'cli_auth_credentials_store')\s*=\s*(["'])(.*?)\1\s*(?:#.*)?$''', line)
        if match and match[2] != "file":
            raise AccountError("This tool requires cli_auth_credentials_store = \"file\" in config.toml.")


def stop_daemon(home):
    env = dict(os.environ, CODEX_HOME=str(home))
    try:
        result = subprocess.run(
            ["codex", "app-server", "daemon", "stop"],
            env=env, capture_output=True, text=True, timeout=60,
        )
    except FileNotFoundError:
        raise AccountError("Cannot find 'codex' on PATH. Credentials have not been switched.") from None
    except subprocess.TimeoutExpired:
        raise AccountError("Daemon shutdown timed out. Credentials have not been switched; check Codex before retrying.") from None
    if result.returncode:
        # Do not relay arbitrary CLI output: it can contain private configuration.
        raise AccountError(
            "Daemon shutdown failed. Credentials have not been switched. "
            "Check 'codex app-server daemon stop' in a separate terminal. "
            "This tool requires a Codex version with daemon management (tested with 0.159.3)."
        )
    try:
        status = json.loads(result.stdout).get("status")
    except (ValueError, AttributeError):
        status = None
    if status not in ("stopped", "notRunning"):
        raise AccountError("Codex did not confirm daemon shutdown. Credentials have not been switched.")


def confirm_switch(yes):
    print(
        "Warning: switching stops the shared Codex daemon. Existing CLI sessions will "
        "disconnect until you start Codex again. Active responses and background tasks "
        "may be interrupted.",
        file=sys.stderr,
    )
    if yes:
        return True
    if not sys.stdin.isatty():
        raise AccountError("Confirmation requires a terminal. Use --yes to explicitly accept the interruption.")
    try:
        return input("Stop the daemon and switch accounts? [y/N] ").strip().lower() in {"y", "yes"}
    except EOFError:
        return False


def switch(home, args):
    target = account_path(home, args.name)
    read_auth(target)
    check_storage(home)
    if not confirm_switch(args.yes):
        print("Cancelled. Credentials unchanged.")
        return
    with account_lock(home):
        # Revalidate after waiting for confirmation, before stopping anything.
        raw, auth = read_auth(target)
        stop_daemon(home)
        current = home / "auth.json"
        if current.exists():
            current_raw, current_auth = read_auth(current)
            previous = matching_account(home, current_auth)
            current_identity = identity(current_auth)
            if current_auth == auth or (current_identity is not None and current_identity == identity(auth)):
                # The user chose this label explicitly, even if duplicate labels exist.
                raw, auth = current_raw, current_auth
                write_auth(target, current_raw)
            elif previous is not None:
                write_auth(previous, current_raw)
        write_auth(current, raw)
    email, _ = describe(auth)
    print(f"Switched to: {args.name} ({email}). Start a new Codex CLI to load this account and reconnect existing sessions.")


def dispatch(home, args):
    if args.command in {"switch", "sw"}:
        switch(home, args)
    elif args.command in {"list", "ls", "current", "whoami"}:
        auth = read_auth(home / "auth.json")[1] if (home / "auth.json").exists() else None
        active = matching_account(home, auth) if auth else None
        if args.command in {"current", "whoami"}:
            if auth is None:
                raise AccountError("No auth.json found. Run 'codex login' first.")
            email, plan = describe(auth)
            print(f"{active.stem if active else '(unsaved)'}  {email}  ({plan})")
            return
        accounts = list(saved_accounts(home))
        if not accounts:
            print("No saved accounts. Use 'add' to save the current login.")
        for path, saved in accounts:
            email, plan = describe(saved)
            marker = " <- active" if path == active else ""
            print(f"{path.stem:20}  {email:30}  ({plan}){marker}")
    elif args.command == "add":
        check_storage(home)
        with account_lock(home):
            raw, auth = read_auth(home / "auth.json")
            email = claims(auth).get("email")
            name = args.name or (email.split("@")[0] if isinstance(email, str) else None)
            if not name:
                raise AccountError("Cannot detect an email. Provide an account name.")
            target = account_path(home, name)
            if target.exists() and not args.force:
                raise AccountError(f"Account '{name}' already exists. Use --force to overwrite.")
            (home / "accounts").mkdir(mode=0o700, exist_ok=True)
            (home / "accounts").chmod(0o700)
            write_auth(target, raw)
        print(f"Saved: {name} ({describe(auth)[0]})")
    elif args.command in {"remove", "rm"}:
        target = account_path(home, args.name)
        with account_lock(home):
            if not target.exists():
                raise AccountError(f"Account '{args.name}' not found.")
            target.unlink()
        print(f"Removed: {args.name}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, prog="codex-accounts")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    commands = parser.add_subparsers(dest="command")
    commands.add_parser("list", aliases=["ls"], help="List saved accounts")
    add = commands.add_parser("add", help="Save the current file-based login")
    add.add_argument("name", nargs="?")
    add.add_argument("-f", "--force", action="store_true")
    change = commands.add_parser("switch", aliases=["sw"], help="Stop the daemon and switch accounts")
    change.add_argument("name")
    change.add_argument("-y", "--yes", action="store_true", help="Accept interruption without prompting")
    remove = commands.add_parser("remove", aliases=["rm"], help="Remove a saved account")
    remove.add_argument("name")
    commands.add_parser("current", aliases=["whoami"], help="Show the login stored on disk")
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0
    try:
        dispatch(codex_home(), args)
    except (AccountError, OSError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nInterrupted. Check the current login before retrying.", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
